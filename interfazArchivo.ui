  <property name="styleSheet">
   <string notr="true">/* ===== Base futurista: fondo oscuro con cuadrícula verde ===== */
QMainWindow {
    background-color: #05080a;
    background-image: url(:/fondo/cuadricula.png);
    background-repeat: repeat;
}
QWidget#centralwidget {
    background-color: #05080a;
    background-image: url(:/fondo/cuadricula.png);
    background-repeat: repeat;
}
QWidget {
    color: #c9d1d9;
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
}

/* ===== Marco principal con borde verde brillante (translúcido) ===== */
QFrame#marcoPrincipal {
    background-color: rgba(8, 12, 14, 150);
    border: 1px solid #1f8f4e;
    border-radius: 14px;
}

/* ===== Editor de código (translúcido) ===== */
QPlainTextEdit#plainTextEdit {
    background-color: rgba(10, 15, 18, 160);
    color: #d6e4dc;
    border: 1px solid #1c2a26;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #1f8f4e;
    selection-color: #ffffff;
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", "Consolas", monospace;
    font-size: 11pt;
}
QPlainTextEdit#plainTextEdit:focus {
    border: 1px solid #2ee66b;
}

/* ===== Botón Compilar / Ejecutar ===== */
QPushButton#botonCompilar {
    background-color: #12301f;
    color: #2ee66b;
    border: 1px solid #2ee66b;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 600;
    min-height: 22px;
}
QPushButton#botonCompilar:hover {
    background-color: #1a4a2e;
    color: #7dffa8;
    border: 1px solid #7dffa8;
}
QPushButton#botonCompilar:pressed {
    background-color: #2ee66b;
    color: #05080a;
}

/* ===== Pestañas ===== */
QTabWidget::pane {
    border: 1px solid #1c2a26;
    border-radius: 8px;
    background-color: rgba(10, 15, 18, 160);
    top: -1px;
}
QTabBar::tab {
    background-color: #0d1417;
    color: #7f9a8d;
    padding: 6px 18px;
    border: 1px solid #1c2a26;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #12301f;
    color: #2ee66b;
    border-color: #1f8f4e;
}
QTabBar::tab:hover:!selected {
    color: #c9d1d9;
    background-color: #111b1e;
}

/* ===== Listas / tablas / texto de paneles ===== */
QTreeWidget, QTableWidget, QPlainTextEdit#textoSalida, QListWidget {
    background-color: rgba(10, 15, 18, 160);
    color: #d6e4dc;
    border: none;
    alternate-background-color: rgba(13, 20, 23, 160);
    gridline-color: #1c2a26;
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", "Consolas", monospace;
}
QHeaderView::section {
    background-color: #0d1417;
    color: #2ee66b;
    border: none;
    border-bottom: 1px solid #1f8f4e;
    padding: 4px 8px;
}

/* ===== Menús, barra de herramientas, estado ===== */
QMenuBar {
    background-color: #05080a;
    color: #c9d1d9;
    border-bottom: 1px solid #1c2a26;
}
QMenuBar::item {
    padding: 5px 12px;
    background: transparent;
}
QMenuBar::item:selected {
    background-color: #12301f;
    color: #2ee66b;
    border-radius: 4px;
}
QMenu {
    background-color: #0a0f12;
    border: 1px solid #1f8f4e;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #12301f;
    color: #2ee66b;
}
QMenu::separator {
    height: 1px;
    background: #1c2a26;
    margin: 4px 8px;
}
QToolBar {
    background-color: #070b0d;
    border: none;
    border-bottom: 1px solid #1c2a26;
    spacing: 6px;
    padding: 4px;
}
QToolButton {
    background: transparent;
    color: #c9d1d9;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px;
}
QToolButton:hover {
    background-color: #12301f;
    border: 1px solid #1f8f4e;
    color: #2ee66b;
}
QStatusBar {
    background-color: #070b0d;
    color: #7f9a8d;
    border-top: 1px solid #1c2a26;
}
QLabel#etiquetaPosicion, QLabel#etiquetaEstado {
    color: #2ee66b;
    padding: 0 8px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #070b0d;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1f8f4e;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #070b0d;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #1f8f4e;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QSplitter::handle {
    background-color: #1c2a26;
}
QSplitter::handle:hover {
    background-color: #2ee66b;
}</string>
